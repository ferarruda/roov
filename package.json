{
  "name": "roov",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "pnpm --filter @roov/api dev",
    "dev:web": "pnpm --filter roov-app dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @roov/api db:migrate",
    "db:studio": "pnpm --filter @roov/api db:studio"
  }
}
